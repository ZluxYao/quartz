# Absolute NAS paths containing this project and the notes to publish.
QUARTZ_PROJECT_PATH=/vol1/1000/blog/quartz-site
QUARTZ_CONTENT_PATH=/vol1/1000/blog/ZluxYao

# Host ports. Container ports stay fixed by the Dockerfile.
QUARTZ_HTTP_PORT=2222
QUARTZ_WS_PORT=2223

# Poll for note changes because some NAS mounts do not forward file events.
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=3000

TZ=Asia/Shanghai
