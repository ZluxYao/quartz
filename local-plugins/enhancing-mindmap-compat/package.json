{
  "name": "@local/enhancing-mindmap-compat",
  "version": "0.1.0",
  "description": "Render Obsidian Enhancing Mindmap notes as Mermaid mind maps in Quartz",
  "type": "module",
  "private": true,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@quartz-community/types": "^0.3.0",
    "mdast-util-to-string": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.0.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "quartz": {
    "name": "enhancing-mindmap-compat",
    "displayName": "Enhancing Mindmap Compatibility",
    "description": "Converts Enhancing Mindmap heading trees into Mermaid mind maps.",
    "category": "transformer",
    "version": "0.1.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [
      "@quartz-community/obsidian-flavored-markdown"
    ],
    "defaultOrder": 35,
    "defaultEnabled": true,
    "defaultOptions": {
      "frontmatterKey": "mindmap-plugin",
      "frontmatterValue": "basic",
      "rootLabel": "思维导图"
    }
  }
}
